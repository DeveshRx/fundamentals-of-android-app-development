<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The manifest file describes essential information about your app to the Android build tools,
         the Android OS, and Google Play. -->
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DBTutoriall">

        <!-- DELETE: Activity for deleting records -->
        <activity
            android:name=".DeleteFlowerActivity"
            android:exported="false"
            android:label="@string/title_activity_delete_flower"
            android:theme="@style/Theme.DBTutoriall" />

        <!-- READ: Activity for viewing all database records -->
        <activity
            android:name=".ViewAllDataActivity"
            android:exported="false"
            android:label="@string/title_activity_view_all_data"
            android:theme="@style/Theme.DBTutoriall" />

        <!-- UPDATE: Activity for editing existing records -->
        <activity
            android:name=".EditDatabaseActivity"
            android:exported="false"
            android:label="@string/title_activity_edit_database"
            android:theme="@style/Theme.DBTutoriall" />

        <!-- MAIN: The launcher activity that opens when you start the app -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/title_activity_main"
            android:theme="@style/Theme.DBTutoriall">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- CREATE: Activity for adding new records -->
        <activity
            android:name=".CreateDataEntryActivityKt"
            android:exported="true"
            android:label="@string/title_activity_main" />
    </application>

</manifest>